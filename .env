# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式: hash | history
VITE_ROUTER_MODE = history

# 接口地址（指向本地代理的路径）
VITE_APP_BASE_API = '/api'

# 核心接口的基础路径 (前端代码统一请求 /sapi, vite代理转发)
VITE_API_BASE_URL=/sapi

# ==============================================================
# 注意：以下变量默认在此文件中不设值，以便自动回落到 vite.config.ts 的默认值。
# 如果你需要联调正式环境，请在根目录创建 .env.local 文件，并在其中写入：
# VITE_SAPI_TARGET=https://api.your-prod-domain.com
# (.env.local 已被 .gitignore 忽略，绝不会提交到代码库中)
# ==============================================================