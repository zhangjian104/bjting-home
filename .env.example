# 环境标识
# Optional: development | test | production
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 有声小说 API 基址（全环境直连；本地联调可在 .env.local 覆盖为 http://127.0.0.1:8788/api）
VITE_API_BASE_URL = https://api.bjting.com/api

# Clerk 认证（Publishable Key，可安全暴露给前端；写入 .env.local 勿提交 Git）
VITE_CLERK_PUBLISHABLE_KEY = pk_live_xxxxx
# 可选：Account Portal 地址（默认 https://accounts.bjting.com/sign-in|sign-up）
# VITE_CLERK_SIGN_IN_URL = https://accounts.bjting.com/sign-in
# VITE_CLERK_SIGN_UP_URL = https://accounts.bjting.com/sign-up

# 可选：开发环境额外代理
# VITE_PROXY = [["/debug","http://127.0.0.1:8788"]]
